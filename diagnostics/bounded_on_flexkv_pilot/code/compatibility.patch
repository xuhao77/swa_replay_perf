+@pytest.mark.parametrize("query_count", [128, 2048, 4096, 8192])
+def test_precompute_falls_back_above_shared_memory_limit(query_count: int):
+    import sgl_kernel.flash_mla as flash_mla
+
+    from sglang.srt.layers.attention.deepseek_v4_backend import (
+        _maybe_precompute_flashmla_sched_meta,
+    )
+
+    queries = torch.empty(
+        (query_count, 1, H_Q, D_QK), dtype=torch.bfloat16, device="cuda"
+    )
+    indices = torch.zeros((query_count, 1, 128), dtype=torch.int32, device="cuda")
+    lengths = torch.full((query_count,), 128, dtype=torch.int32, device="cuda")
+    schedule = flash_mla.FlashMLASchedMeta()
+    _maybe_precompute_flashmla_sched_meta(
+        schedule,
+        q=queries,
+        indices=indices,
+        topk_length=lengths,
+        extra_indices=None,
+        extra_topk_length=None,
+    )
+    torch.cuda.synchronize()
+    if query_count >= 4096:
+        assert schedule.tile_scheduler_metadata is None
+        assert schedule.num_splits is None
+    else:
+        assert schedule.tile_scheduler_metadata is not None
+        assert schedule.num_splits.shape == (query_count + 1,)
+
+
+@pytest.mark.parametrize("query_count", [4096, 8192])
+def test_native_schedule_handles_large_prefill(query_count: int):
+    lengths = torch.full((query_count,), 128, dtype=torch.int32, device="cuda")
+    output, logsumexp, schedule = _call(_cache(), query_count, 1, 128, lengths)
+    assert output.shape[0] == query_count
+    assert logsumexp.shape[0] == query_count
+    assert schedule.have_initialized
+    assert schedule.config.b == query_count
+
